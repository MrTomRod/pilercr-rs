diff -ruN a/trace.cpp b/trace.cpp
--- a/trace.cpp
+++ b/trace.cpp
@@ -0,0 +1,173 @@
+#include <filesystem>
+#include "pilercr.h"
+
+bool g_TraceEnabled = false;
+static FILE *TraceFiles[16] = {0};
+static unsigned MSACallIndex = 0;
+static const char *TraceStages[] =
+	{
+	"01-parameters", "02-contigs", "03-filter-hits", "04-trapezoids",
+	"05-dp-hits", "06-images", "07-piles", "08-expanded-piles",
+	"09-hit-piles", "10-edges", "11-components", "12-draft-arrays",
+	"13-msa", "14-bounds", "15-decisions", "16-final-arrays"
+	};
+
+static void TraceError(const char *Action, const char *Path)
+	{
+	fprintf(stderr, "Trace error: %s: %s\n", Action, Path);
+	exit(EXIT_FAILURE);
+	}
+
+void TraceOpen(const char *Dir)
+	{
+	if (Dir == 0)
+		return;
+	std::error_code Error;
+	const std::filesystem::path Path(Dir);
+	bool Exists = std::filesystem::exists(Path, Error);
+	if (Error)
+		TraceError("cannot inspect directory", Dir);
+	if (Exists)
+		{
+		bool Empty = std::filesystem::is_empty(Path, Error);
+		if (Error || !std::filesystem::is_directory(Path, Error) || Error || !Empty)
+			TraceError("expected an empty directory", Dir);
+		}
+	else if (!std::filesystem::create_directories(Path, Error) || Error)
+		TraceError("cannot create directory", Dir);
+
+	for (int i = 0; i < 16; ++i)
+		{
+		std::string Name = (Path / (std::string(TraceStages[i]) + ".tsv")).string();
+		TraceFiles[i] = fopen(Name.c_str(), "wbx");
+		if (TraceFiles[i] == 0)
+			TraceError("cannot create file", Name.c_str());
+		if (fprintf(TraceFiles[i], "# pilercr-trace-v1\t%s\tzero-based;native-endpoints\n",
+		  TraceStages[i]) < 0 || fflush(TraceFiles[i]) != 0)
+			TraceError("cannot write header", Name.c_str());
+		}
+	g_TraceEnabled = true;
+	MSACallIndex = 0;
+	}
+
+void TraceRow(int Stage, const char *Format, ...)
+	{
+	if (!g_TraceEnabled)
+		return;
+	FILE *f = TraceFiles[Stage - 1];
+	va_list Args;
+	va_start(Args, Format);
+	int Result = vfprintf(f, Format, Args);
+	va_end(Args);
+	if (Result < 0 || fputc('\n', f) == EOF)
+		TraceError("cannot write stage", TraceStages[Stage - 1]);
+	}
+
+void TraceClose()
+	{
+	if (!g_TraceEnabled)
+		return;
+	for (int i = 0; i < 16; ++i)
+		{
+		if (fclose(TraceFiles[i]) != 0)
+			TraceError("cannot close stage", TraceStages[i]);
+		TraceFiles[i] = 0;
+		}
+	g_TraceEnabled = false;
+	}
+
+std::string TraceEscape(const std::string &s)
+	{
+	std::string Result;
+	for (size_t i = 0; i < s.size(); ++i)
+		switch (s[i])
+			{
+			case '\\': Result += "\\\\"; break;
+			case '\t': Result += "\\t"; break;
+			case '\r': Result += "\\r"; break;
+			case '\n': Result += "\\n"; break;
+			default: Result += s[i];
+			}
+	return Result;
+	}
+
+std::string TraceSeq(const Seq &s)
+	{
+	return TraceEscape(std::string(s.begin(), s.end()));
+	}
+
+std::string TraceIndexes(const IntVec &Indexes)
+	{
+	std::string Result;
+	for (size_t i = 0; i < Indexes.size(); ++i)
+		{
+		if (i != 0)
+			Result += ',';
+		Result += std::to_string(Indexes[i]);
+		}
+	return Result;
+	}
+
+void TracePiles(int Stage)
+	{
+	if (!g_TraceEnabled)
+		return;
+	for (size_t i = 0; i < g_Piles.size(); ++i)
+		{
+		const PileData &P = g_Piles[i];
+		TraceRow(Stage, "%zu\t%d\t%d\t%d\t%s", i, P.Lo, P.Hi,
+		  P.Deleted ? 1 : 0, TraceIndexes(P.HitIndexes).c_str());
+		}
+	}
+
+void TraceMSA(const MSA &Aln)
+	{
+	if (!g_TraceEnabled)
+		return;
+	const unsigned Call = MSACallIndex++;
+	// IDs are assigned from the input order by MultipleAlign. Do not sort Aln.
+	for (unsigned i = 0; i < Aln.GetSeqCount(); ++i)
+		{
+		// FromSeq does not necessarily allocate an ID map for a singleton.
+		unsigned Row = Aln.GetSeqCount() == 1 ? 0 : Aln.GetSeqIndex(i);
+		std::string Bytes;
+		for (unsigned Col = 0; Col < Aln.GetColCount(); ++Col)
+			Bytes += Aln.GetChar(Row, Col);
+		TraceRow(13, "%u\t%u\t%s", Call, i, TraceEscape(Bytes).c_str());
+		}
+	}
+
+void TraceBounds(const ArrayAln &AA, const char *When)
+	{
+	if (!g_TraceEnabled)
+		return;
+	for (size_t i = 0; i < AA.Repeats.size(); ++i)
+		TraceRow(14, "%d\t%s\t%d\t%zu\t%s\t%s\t%s", AA.Id, When, AA.Pos, i,
+		  TraceEscape(AA.LeftFlanks[i]).c_str(), TraceEscape(AA.Repeats[i]).c_str(),
+		  TraceEscape(AA.Spacers[i]).c_str());
+	}
+
+void TraceDrafts(const std::vector<ArrayData *> &ADVec)
+	{
+	if (!g_TraceEnabled)
+		return;
+	for (size_t i = 0; i < ADVec.size(); ++i)
+		{
+		const ArrayData &AD = *ADVec[i];
+		TraceRow(12, "%d\t%s\t%s", AD.Id, TraceIndexes(AD.PileIndexes).c_str(),
+		  TraceSeq(AD.ConsSeq).c_str());
+		}
+	}
+
+void TraceFinal(const std::vector<ArrayAln *> &AAVec)
+	{
+	if (!g_TraceEnabled)
+		return;
+	for (size_t i = 0; i < AAVec.size(); ++i)
+		{
+		const ArrayAln &AA = *AAVec[i];
+		TraceRow(16, "%d\t%d\t%s\t%s\t%zu", AA.Id, AA.Pos,
+		  TraceSeq(AA.ConsSeq).c_str(), TraceSeq(AA.AlignedConsSeq).c_str(),
+		  AA.Repeats.size());
+		}
+	}
